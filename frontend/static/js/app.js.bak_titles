/* GeneCurator frontend logic.
 *
 * One Alpine component per step. They share a thin api() helper for HTTP
 * calls and a renderPlotly() helper that consumes the dict format returned
 * by backend/plots.py.
 */

// -------- HTTP helper -----------------------------------------------------
async function api(path, opts = {}) {
  const res = await fetch(path, {
    credentials: "same-origin",
    headers: opts.body && !(opts.body instanceof FormData) ? { "Content-Type": "application/json" } : {},
    ...opts,
  });
  if (!res.ok) {
    let msg = await res.text();
    try { msg = JSON.parse(msg).detail || msg; } catch (_) {}
    throw new Error(`${res.status}: ${msg}`);
  }
  return res.json();
}

// -------- Theme helpers ---------------------------------------------------
function currentTheme() {
  return document.documentElement.getAttribute("data-theme") || "light";
}
function themeColors() {
  const cs = getComputedStyle(document.documentElement);
  return {
    paper: cs.getPropertyValue("--plot-paper").trim() || "#ffffff",
    grid:  cs.getPropertyValue("--plot-grid").trim()  || "#e5e7eb",
    text:  cs.getPropertyValue("--plot-text").trim()  || "#1f2937",
  };
}

// -------- Plot rendering --------------------------------------------------
const _lastFigures = {};

function applyThemeToLayout(layout) {
  const c = themeColors();
  const out = JSON.parse(JSON.stringify(layout || {}));
  out.paper_bgcolor = c.paper;
  out.plot_bgcolor = c.paper;
  out.font = Object.assign({}, out.font, { color: c.text });
  for (const key of Object.keys(out)) {
    if (/^[xy]axis/.test(key)) {
      out[key] = Object.assign({}, out[key], {
        gridcolor: c.grid,
        zerolinecolor: c.grid,
        linecolor: c.grid,
        tickfont: Object.assign({}, (out[key] || {}).tickfont, { color: c.text }),
      });
    }
  }
  if (out.legend) out.legend = Object.assign({}, out.legend, { font: { color: c.text } });
  if (out.coloraxis && out.coloraxis.colorbar) {
    out.coloraxis.colorbar = Object.assign({}, out.coloraxis.colorbar, {
      tickfont: { color: c.text }, title: out.coloraxis.colorbar.title,
    });
  }
  return out;
}

// Map purple/indigo colors (from the old palette) to navy in Plotly traces.
// The backend `plots.py` still emits the old indigo hues; rather than edit
// backend, we remap on the client so everything matches the brand.
const _COLOR_REMAP = {
  // Old indigo/purple → new navy
  "#6366f1": "#0369a1",
  "#818cf8": "#0284c7",
  "#7f77dd": "#0369a1",
  "#a5b4fc": "#7dd3fc",
  "#8b5cf6": "#0369a1",
  "#4f46e5": "#0c3f66",
  "#4338ca": "#0c3f66",
  "#c7d2fe": "#bae6fd",
  "#e0e7ff": "#e0f2fe",
  "#ede9fe": "#e0f2fe",
  // Old pinks/roses that were paired → coral tones
  "#ec4899": "#ea580c",
  "#f472b6": "#f97316",
  "#fbcfe8": "#fed7aa",
};

function _remapColor(c) {
  if (typeof c !== "string") return c;
  const lower = c.toLowerCase();
  return _COLOR_REMAP[lower] || c;
}

function _remapColorList(arr) {
  return Array.isArray(arr) ? arr.map(_remapColor) : _remapColor(arr);
}

function remapTraceColors(data) {
  // Deep-scan each trace and replace old-palette colors.
  return (data || []).map(trace => {
    const t = JSON.parse(JSON.stringify(trace));
    if (t.marker) {
      if (t.marker.color) t.marker.color = _remapColorList(t.marker.color);
      if (t.marker.line && t.marker.line.color)
        t.marker.line.color = _remapColorList(t.marker.line.color);
      if (t.marker.colorscale && Array.isArray(t.marker.colorscale)) {
        t.marker.colorscale = t.marker.colorscale.map(stop =>
          Array.isArray(stop) ? [stop[0], _remapColor(stop[1])] : stop);
      }
    }
    if (t.line && t.line.color) t.line.color = _remapColorList(t.line.color);
    if (t.fillcolor) t.fillcolor = _remapColor(t.fillcolor);
    if (t.textfont && t.textfont.color) t.textfont.color = _remapColor(t.textfont.color);
    return t;
  });
}

function renderPlotly(divId, fig) {
  if (!fig || fig.empty) {
    document.getElementById(divId).innerHTML =
      '<div class="p-8 text-center text-sm" style="color: var(--text-faint);">No data to display.</div>';
    delete _lastFigures[divId];
    return;
  }
  _lastFigures[divId] = fig;
  const layout = applyThemeToLayout(fig.layout || {});
  const data = remapTraceColors(fig.data || []);
  Plotly.newPlot(divId, data, layout, { responsive: true, displaylogo: false });
}

function reskinAllPlots() {
  for (const divId of Object.keys(_lastFigures)) {
    const el = document.getElementById(divId);
    if (!el || !_lastFigures[divId]) continue;
    const layout = applyThemeToLayout(_lastFigures[divId].layout || {});
    const data = remapTraceColors(_lastFigures[divId].data || []);
    Plotly.react(divId, data, layout, { responsive: true, displaylogo: false });
  }
}

// =========================================================================
// STEP 1 — Data Upload
// =========================================================================
function step1() {
  return {
    busy: false,
    busyKind: null,
    dataLoaded: false,
    filename: "",
    rows: 0,
    columns: [],
    mapping: { g_col: "", p_col: "", fc_col: "" },

    // Which example dataset is selected in the radio group.
    // Default to TCGA-BRCA — it's the more scientifically relevant option
    // and makes the more informative first impression.
    exampleChoice: "tcga_brca",

    async init() {
      try {
        const st = await api("/api/state");
        if (st.data_loaded) {
          this.dataLoaded = true;
          this.filename = st.filename || "";
          this.rows = st.rows;
          this.columns = st.columns;
          this.mapping = st.mapping;
        }
      } catch (e) {}
    },

    // Unified loader for the example dataset card. Routes to the correct
    // backend endpoint based on the current radio selection. The two
    // underlying endpoints (/api/load-toy, /api/load-use-case) are
    // unchanged — this is purely a UI-side consolidation.
    async loadExample() {
      const choice = this.exampleChoice;
      const endpoint = choice === "tcga_brca"
        ? "/api/load-use-case"
        : "/api/load-toy";
      this.busy = true;
      this.busyKind = "example";
      try {
        const r = await api(endpoint, { method: "POST" });
        this.dataLoaded = true;
        this.filename = r.filename;
        this.rows = r.rows;
        this.columns = r.columns;
        this.mapping = r.mapping;
      } catch (e) { alert(e.message); }
      finally { this.busy = false; this.busyKind = null; }
    },

    async onFile(ev) {
      const file = ev.target.files[0];
      if (!file) return;
      this.busy = true; this.busyKind = "upload";
      const fd = new FormData();
      fd.append("file", file);
      try {
        const r = await api("/api/upload", { method: "POST", body: fd });
        this.dataLoaded = true;
        this.filename = r.filename;
        this.rows = r.rows;
        this.columns = r.columns;
        this.mapping = r.mapping;
      } catch (e) { alert(e.message); }
      finally { this.busy = false; this.busyKind = null; }
    },

    async saveMapping() {
      try { await api("/api/columns", { method: "POST", body: JSON.stringify(this.mapping) }); }
      catch (e) { alert(e.message); }
    },

    next() { window.location = "/step/2"; },
  };
}

// =========================================================================
// STEP 2 — Feature Selection
// =========================================================================
function step2() {
  return {
    state: {},
    strategy: "Random Forest (Ensemble)",
    top_n: 50,
    p_thr: 0.05,
    fc_thr: 1.0,
    busy: false,

    async init() {
      try {
        this.state = await api("/api/state");
        if (!this.state.data_loaded) { window.location = "/step/1"; return; }
        this.strategy = this.state.strategy;
        this.top_n = this.state.top_n;
        this.p_thr = this.state.p_thr;
        this.fc_thr = this.state.fc_thr;
      } catch (e) { alert(e.message); }
    },

    barPct(n) {
      const t = (this.state.direction?.up || 0) + (this.state.direction?.down || 0);
      return t > 0 ? (n / t * 100).toFixed(1) : 0;
    },

    async pickStrategy(key) {
      this.strategy = key;
      await this._saveStrategy();
    },

    async _saveStrategy() {
      try {
        await api("/api/strategy", {
          method: "POST",
          body: JSON.stringify({
            strategy: this.strategy,
            top_n: this.top_n,
            p_thr: this.p_thr,
            fc_thr: this.fc_thr,
          }),
        });
      } catch (e) { alert(e.message); }
    },

    back() { window.location = "/step/1"; },

    async run() {
      this.busy = true;
      await this._saveStrategy();
      try {
        await api("/api/run", { method: "POST" });
        window.location = "/step/3";
      } catch (e) { alert(e.message); this.busy = false; }
    },
  };
}

// =========================================================================
// STEP 3 — Expert Review
// =========================================================================
function step3() {
  return {
    state: {},
    inspectedSymbol: "",
    inspectorOptions: [],
    inspectorFilter: "",
    gene: null,

    // Agent (LLM-assisted curation) state
    agentBusy: false,
    agentError: "",
    agentContext: "",             // returned by agent (summary of context)
    agentContext_input: "",       // user's typed context (bound to input field)
    agentContextProvided: false,  // was context provided by user? drives warn styling
    agentRemovals: [],
    agentAdditions: [],
    get agentHasResults() {
      return this.agentContext || this.agentRemovals.length || this.agentAdditions.length;
    },

    // Trigger the agent to analyze the current panel and return curation
    // suggestions. Displays them in a side panel that the user can accept
    // or dismiss one-by-one.
    async requestAgentSuggestions() {
      this.agentBusy = true;
      this.agentError = "";
      try {
        const r = await api("/api/agent/suggest-curation", {
          method: "POST",
          body: JSON.stringify({ context: this.agentContext_input || "" }),
        });
        if (!r.ok) {
          this.agentError = r.error || "Agent unavailable";
          this.agentContext = "";
          this.agentContextProvided = false;
          this.agentRemovals = [];
          this.agentAdditions = [];
        } else {
          this.agentContext = r.context_summary || "";
          this.agentContextProvided = !!r.context_provided;
          this.agentRemovals = r.remove_suggestions || [];
          this.agentAdditions = r.add_suggestions || [];
          if (!this.agentRemovals.length && !this.agentAdditions.length) {
            this.agentError = "The panel already looks well-curated — no suggestions.";
          }
        }
      } catch (e) {
        this.agentError = `Agent unavailable: ${e.message}`;
      } finally {
        this.agentBusy = false;
      }
    },

    // Apply a removal suggestion: reject the gene from the panel, then
    // drop the suggestion from the list so it doesn't clutter the UI.
    async acceptRemoval(symbol) {
      await this.removeGene(symbol);
      this.agentRemovals = this.agentRemovals.filter(s => s.symbol !== symbol);
    },

    // Apply an addition suggestion: add the gene to the panel.
    async acceptAddition(symbol) {
      await this.addGene(symbol);
      this.agentAdditions = this.agentAdditions.filter(s => s.symbol !== symbol);
    },

    // User rejected a suggestion — just drop it from the list.
    dismissSuggestion(symbol, action) {
      if (action === "remove") {
        this.agentRemovals = this.agentRemovals.filter(s => s.symbol !== symbol);
      } else {
        this.agentAdditions = this.agentAdditions.filter(s => s.symbol !== symbol);
      }
    },

    // Filter the inspector dropdown by user's text input. Case-insensitive
    // prefix + substring match. Cap at 500 results to keep the select
    // performant even on datasets with 20k+ genes.
    get filteredInspectorOptions() {
      const f = (this.inspectorFilter || "").trim().toUpperCase();
      if (!f) return this.inspectorOptions.slice(0, 500);
      const prefix = [];
      const contains = [];
      for (const sym of this.inspectorOptions) {
        const S = sym.toUpperCase();
        if (S.startsWith(f)) prefix.push(sym);
        else if (S.includes(f)) contains.push(sym);
        if (prefix.length + contains.length >= 500) break;
      }
      return prefix.concat(contains);
    },

    // When the user types in the search box, keep the currently-inspected
    // symbol in sync with the filtered list. Otherwise the dropdown displays
    // (visually) the first match but x-model still holds the previous value,
    // so the details card keeps showing the old gene.
    onFilterChange() {
      const opts = this.filteredInspectorOptions;
      if (opts.length === 0) return;
      if (!opts.includes(this.inspectedSymbol)) {
        this.inspectedSymbol = opts[0];
        this.loadGene(opts[0]);
      }
    },

    async init() {
      await this.refreshState();
      if (!this.state.ran_pipeline) { window.location = "/step/2"; return; }
      this._buildInspectorOptions();
      const candidate = this.state.final?.[0] || this.state.algo_picks?.[0];
      if (candidate) {
        this.inspectedSymbol = candidate;
        await this.loadGene(candidate);
      }
    },

    async refreshState() {
      this.state = await api("/api/state");
    },

    _buildInspectorOptions() {
      // Use the full dataset symbol list if available (this is the
      // canonical set the user can add from). Fall back to panel + added
      // if state hasn't been populated yet.
      if (Array.isArray(this.state.all_symbols) && this.state.all_symbols.length) {
        this.inspectorOptions = this.state.all_symbols;
        return;
      }
      const set = new Set();
      (this.state.table_rows || []).forEach(r => set.add(r.gene));
      (this.state.added || []).forEach(g => set.add(g));
      this.inspectorOptions = Array.from(set).sort();
    },

    async loadGene(symbol) {
      if (!symbol) { this.gene = null; return; }
      try {
        this.gene = await api(`/api/gene/${encodeURIComponent(symbol)}`);
      } catch (e) {
        console.error(`loadGene(${symbol}) failed:`, e);
        this.gene = null;
      }
    },

    inspect(symbol) {
      this.inspectedSymbol = symbol;
      this.loadGene(symbol);
    },

    async toggleRow(gene, checked) {
      const rejected = new Set(this.state.rejected || []);
      const added = new Set(this.state.added || []);
      const algoSet = new Set(this.state.algo_picks || []);
      if (!checked) {
        if (algoSet.has(gene)) rejected.add(gene);
        else added.delete(gene);
      } else {
        if (algoSet.has(gene)) rejected.delete(gene);
        else added.add(gene);
      }
      await this._submitCurate([...rejected], [...added]);
    },

    async addGene(gene) {
      const rejected = new Set(this.state.rejected || []);
      const added = new Set(this.state.added || []);
      const algoSet = new Set(this.state.algo_picks || []);
      if (algoSet.has(gene)) rejected.delete(gene);
      else added.add(gene);
      await this._submitCurate([...rejected], [...added]);
      this._buildInspectorOptions();
    },

    async removeGene(gene) {
      const rejected = new Set(this.state.rejected || []);
      const added = new Set(this.state.added || []);
      const algoSet = new Set(this.state.algo_picks || []);
      if (algoSet.has(gene)) rejected.add(gene);
      else added.delete(gene);
      await this._submitCurate([...rejected], [...added]);
    },

    async _submitCurate(rejected, added) {
      try {
        await api("/api/curate", { method: "POST", body: JSON.stringify({ rejected, added }) });
        await this.refreshState();
        if (this.inspectedSymbol) await this.loadGene(this.inspectedSymbol);
      } catch (e) { alert(e.message); }
    },

    async reset() {
      await this._submitCurate([], []);
    },

    async clearAll() {
      await this._submitCurate(this.state.algo_picks || [], []);
    },
  };
}

// =========================================================================
// STEP 4 — Results
// =========================================================================
function step4() {
  return {
    state: {},
    active: "volcano",
    tabs: [
      { id: "volcano",    label: "Discovery summary", icon: "ti-chart-histogram" },
      { id: "ppi",        label: "PPI network",       icon: "ti-affiliate" },
      { id: "enrichment", label: "Enrichment",        icon: "ti-target" },
      { id: "lr",         label: "LR pairs",          icon: "ti-arrows-exchange" },
      { id: "log2fc",     label: "Log2FC profile",    icon: "ti-temperature-sun" },
    ],
    metrics: { final: 0, up: 0, down: 0, sig: 0, pct_up: 0, pct_down: 0 },
    topDiscoveries: [],
    ppiMeta: null,
    lrData: null,
    lrError: "",
    _loaded: {},

    async init() {
      this.state = await api("/api/state");
      if (!this.state.ran_pipeline) { window.location = "/step/3"; return; }
      const top = await api("/api/top-discoveries");
      this.topDiscoveries = top.rows;
      const up = top.rows.filter(r => r.log2fc > 0).length;
      const down = top.rows.filter(r => r.log2fc < 0).length;
      const sig = top.rows.filter(r => r.p_value < 0.05).length;
      const total = Math.max(this.state.n_final, 1);
      this.metrics = {
        final: this.state.n_final,
        up, down, sig,
        pct_up:   Math.round(up / total * 100),
        pct_down: Math.round(down / total * 100),
      };
      await this.switchTab("volcano");
    },

    async switchTab(id) {
      this.active = id;
      // The Enrichment tab has its own component that self-initializes;
      // don't fetch anything at the step4 level for it.
      if (id === "enrichment") { this._loaded[id] = true; return; }
      // LR tab hits its own annotation endpoint, not the plot endpoint.
      if (id === "lr") {
        if (this._loaded[id]) return;
        try {
          this.lrError = "";
          const r = await api("/api/lr-annotation");
          if (!r.ok) {
            this.lrError = r.error || "LR annotation unavailable";
            this.lrData = null;
          } else {
            this.lrData = r;
          }
          this._loaded[id] = true;
        } catch (e) {
          this.lrError = `LR annotation unavailable: ${e.message}`;
        }
        return;
      }
      if (this._loaded[id]) return;
      try {
        const fig = await api(`/api/plot/${id}`);
        if (id === "ppi") this.ppiMeta = fig;
        renderPlotly(`plot-${id}`, fig);
        this._loaded[id] = true;
      } catch (e) { alert(e.message); }
    },

    // Helper: build a PubMed URL from an evidence field. Evidence may be
    // one or multiple PMIDs separated by commas or semicolons.
    firstPubmedUrl(evidence) {
      if (!evidence) return "";
      const first = String(evidence).split(/[,;\s]+/).find(x => /^\d+$/.test(x));
      return first ? `https://pubmed.ncbi.nlm.nih.gov/${first}/` : "";
    },

    // Send an "add gene" request. Reused when the user accepts a partial
    // pair suggestion. Reloads state so the panel + LR tab update.
    async addGeneFromLR(symbol) {
      try {
        // Reuse the same curate mechanism that step 3 uses: fetch state,
        // add the symbol to the "added" set (if not already picked by the
        // algorithm), and POST /api/curate.
        const rejected = new Set(this.state.rejected || []);
        const added = new Set(this.state.added || []);
        const algoSet = new Set(this.state.algo_picks || []);
        if (algoSet.has(symbol)) rejected.delete(symbol);
        else added.add(symbol);
        await api("/api/curate", {
          method: "POST",
          body: JSON.stringify({ rejected: [...rejected], added: [...added] }),
        });
        // Refresh the local state and the LR annotation (which depends on
        // the current panel composition).
        this.state = await api("/api/state");
        this._loaded["lr"] = false;
        await this.switchTab("lr");
      } catch (e) {
        alert(`Could not add ${symbol}: ${e.message}`);
      }
    },

    async restart() {
      await api("/api/reset", { method: "POST" });
      window.location = "/";
    },
  };
}

// =========================================================================
// THEME TOGGLE — lives in the top nav on every page
// =========================================================================
function themeToggle() {
  return {
    theme: currentTheme(),

    toggle() {
      this.theme = this.theme === "dark" ? "light" : "dark";
      document.documentElement.setAttribute("data-theme", this.theme);
      try { localStorage.setItem("genecurator-theme", this.theme); } catch (e) {}
      if (typeof reskinAllPlots === "function") reskinAllPlots();
    },
  };
}

// =========================================================================
// ENRICHMENT — inline component for the Step 4 "Enrichment" tab.
// Runs Fisher's exact + BH FDR against the 12 Enrichr libraries; for KEGG,
// clicking a term opens a modal with the official KEGG map, gene boxes
// colored by log2FC.
// =========================================================================
function enrichment() {
  return {
    // Status & catalog
    status: null,
    activeGroup: "pathways",
    activeLibrary: null,
    loading: false,
    error: null,

    // Cached results, keyed by library id
    results: {},

    // KEGG modal state — the modal is a DOM node built directly in <body>
    // by openMap(); we only track the ESC-key handler for cleanup.
    _escHandler: null,

    async init() {
      await this.loadStatus();
    },

    async loadStatus() {
      try {
        const r = await fetch("/api/enrichment/status");
        if (!r.ok) throw new Error(`HTTP ${r.status}`);
        this.status = await r.json();
        for (const group of Object.keys(this.status.catalog)) {
          for (const [libId, _label] of this.status.catalog[group]) {
            if (this.status.libraries[libId]) {
              this.activeGroup = group;
              this.activeLibrary = libId;
              await this.loadLibrary(libId);
              return;
            }
          }
        }
        this.error = "No enrichment libraries found. Place the .txt files " +
                     "in the project root (next to run.py).";
      } catch (e) {
        this.error = `Failed to load enrichment status: ${e.message}`;
      }
    },

    groupHasAvailableLib(group) {
      if (!this.status || !this.status.catalog[group]) return false;
      return this.status.catalog[group].some(([libId, _l]) => this.status.libraries[libId]);
    },

    selectGroup(group) {
      this.activeGroup = group;
      for (const [libId, _label] of this.status.catalog[group]) {
        if (this.status.libraries[libId]) {
          this.selectLibrary(libId);
          return;
        }
      }
    },

    async selectLibrary(libId) {
      this.activeLibrary = libId;
      if (!this.results[libId]) {
        await this.loadLibrary(libId);
      }
    },

    async loadLibrary(libId) {
      this.loading = true;
      this.error = null;
      try {
        const r = await fetch(`/api/enrichment/${libId}?top_n=25`);
        if (!r.ok) {
          const err = await r.json().catch(() => ({}));
          throw new Error(err.detail || `HTTP ${r.status}`);
        }
        const data = await r.json();
        this.results[libId] = data.results;
      } catch (e) {
        this.error = `Failed to load ${libId}: ${e.message}`;
        this.results[libId] = [];
      } finally {
        this.loading = false;
      }
    },

    currentResults() {
      if (!this.activeLibrary) return [];
      return this.results[this.activeLibrary] || [];
    },

    libraryLabel(libId) {
      for (const group of Object.values(this.status?.catalog || {})) {
        for (const [id, label] of group) {
          if (id === libId) return label;
        }
      }
      return libId;
    },

    isKeggLibrary() {
      return this.activeLibrary === "KEGG_2026";
    },

    async openMap(term) {
      if (!this.isKeggLibrary() || !this.status?.kegg_maps_available) return;

      // Build the modal directly in <body> — bypasses any nested overflow-hidden
      // or scope issues with Alpine's x-teleport. Using plain DOM APIs keeps
      // this bulletproof: no dependency on Alpine's reactive rendering for
      // the modal's visibility.
      this._removeMapModal();  // clean up any previous
      const overlay = document.createElement("div");
      overlay.id = "gc-map-overlay";
      overlay.style.cssText =
        "position:fixed;inset:0;background:rgba(0,0,0,0.7);" +
        "z-index:99999;display:flex;align-items:center;justify-content:center;" +
        "padding:20px;";
      overlay.innerHTML = `
        <div style="background:#fff;border-radius:12px;padding:16px;
                    width:min(1100px,95vw);max-height:92vh;
                    display:flex;flex-direction:column;
                    box-shadow:0 20px 60px rgba(0,0,0,0.4);"
             id="gc-map-panel">
          <div style="display:flex;justify-content:space-between;
                      align-items:baseline;margin-bottom:12px;">
            <div>
              <div id="gc-map-title" style="font-size:15px;font-weight:600;color:#1f2937;"></div>
              <div id="gc-map-meta" style="font-size:12px;color:#6b7280;margin-top:2px;"></div>
            </div>
            <button id="gc-map-close" style="padding:6px 12px;border-radius:6px;
                    border:1px solid #d1d5db;background:#fff;cursor:pointer;
                    font-size:13px;color:#374151;">✕ Close</button>
          </div>
          <div id="gc-map-body" style="flex:1;overflow:auto;
                                        background:#fff;border-radius:6px;
                                        display:flex;align-items:flex-start;
                                        justify-content:center;">
            <div style="padding:60px;color:#6b7280;font-size:14px;">
              Loading pathway map...
            </div>
          </div>
          <div style="margin-top:12px;display:flex;gap:16px;align-items:center;
                      font-size:12px;color:#4b5563;flex-wrap:wrap;">
            <span style="font-weight:600;">Log2 fold change:</span>
            <span style="display:flex;align-items:center;gap:6px;">
              <span style="display:inline-block;width:16px;height:12px;border-radius:2px;
                           background:rgba(37,99,235,0.7);border:1px solid #1d4ed8;"></span>
              Strongly down
            </span>
            <span style="display:flex;align-items:center;gap:6px;">
              <span style="display:inline-block;width:16px;height:12px;border-radius:2px;
                           background:rgba(37,99,235,0.35);border:1px solid #1d4ed8;"></span>
              Down
            </span>
            <span style="display:flex;align-items:center;gap:6px;">
              <span style="display:inline-block;width:16px;height:12px;border-radius:2px;
                           background:rgba(220,38,38,0.35);border:1px solid #b91c1c;"></span>
              Up
            </span>
            <span style="display:flex;align-items:center;gap:6px;">
              <span style="display:inline-block;width:16px;height:12px;border-radius:2px;
                           background:rgba(220,38,38,0.7);border:1px solid #b91c1c;"></span>
              Strongly up
            </span>
          </div>
        </div>
      `;

      // Attach to body — NOT to any nested container that could clip us
      document.body.appendChild(overlay);

      // Wire up close behavior
      const close = () => this._removeMapModal();
      document.getElementById("gc-map-close").onclick = close;
      overlay.onclick = (e) => { if (e.target === overlay) close(); };
      this._escHandler = (e) => { if (e.key === "Escape") close(); };
      document.addEventListener("keydown", this._escHandler);

      // Set title while we wait
      document.getElementById("gc-map-title").textContent = term;

      // Fetch the map
      try {
        const r = await fetch(`/api/kegg-map?term=${encodeURIComponent(term)}`);
        if (!r.ok) {
          const err = await r.json().catch(() => ({}));
          const message = typeof err.detail === "string"
            ? err.detail
            : (err.detail?.message || `HTTP ${r.status}`);
          throw new Error(message);
        }
        const data = await r.json();

        // Fill in the modal — check it's still open first
        const body = document.getElementById("gc-map-body");
        if (!body) return;  // user closed it while we were fetching
        body.innerHTML = data.svg;

        const meta = document.getElementById("gc-map-meta");
        if (meta) {
          meta.textContent = `${data.pathway_id} · ${data.highlighted}/${data.total_boxes} `
                           + `gene boxes highlighted · ${data.hit_genes.length} genes matched`;
        }
      } catch (e) {
        const body = document.getElementById("gc-map-body");
        if (body) {
          body.innerHTML = `<div style="padding:40px;color:#be185d;font-size:13px;">
                              <strong>Failed to load pathway map:</strong> ${e.message}
                            </div>`;
        }
      }
    },

    _removeMapModal() {
      const existing = document.getElementById("gc-map-overlay");
      if (existing) existing.remove();
      if (this._escHandler) {
        document.removeEventListener("keydown", this._escHandler);
        this._escHandler = null;
      }
    },

    closeMap() {
      this._removeMapModal();
    },

    fmtP(p) {
      if (p === 0) return "0";
      if (p < 0.001) return p.toExponential(2);
      return p.toFixed(4);
    },
    fmtOverlap(row) { return `${row.overlap} / ${row.term_size}`; },

    barLenP(row, allRows) {
      const values = allRows.map(r => -Math.log10(Math.max(r.p_value, 1e-300)));
      const max = Math.max(...values);
      const thisVal = -Math.log10(Math.max(row.p_value, 1e-300));
      return Math.max(2, (thisVal / max) * 100);
    },
  };
}

// =========================================================================
// COMPONENT REGISTRATION
// =========================================================================
document.addEventListener("alpine:init", () => {
  Alpine.data("step1", step1);
  Alpine.data("step2", step2);
  Alpine.data("step3", step3);
  Alpine.data("step4", step4);
  Alpine.data("themeToggle", themeToggle);
  Alpine.data("enrichment", enrichment);
});
