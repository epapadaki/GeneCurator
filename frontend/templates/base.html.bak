{# Base layout shared by all four wizard steps. #}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GeneCurator</title>

  {# Custom SVG favicon — GC monogram with coral DNA crossbar #}
  <link rel="icon" href="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'><rect width='40' height='40' rx='4' fill='%230369a1'/><path d='M 20 8 A 12 12 0 1 0 32 20 L 22 20' stroke='white' stroke-width='2.8' fill='none' stroke-linecap='round'/><path d='M 22 20 Q 26 17.5 30.5 20' stroke='%23ea580c' stroke-width='1.6' fill='none' stroke-linecap='round'/><path d='M 22 20 Q 26 22.5 30.5 20' stroke='%23ea580c' stroke-width='1.6' fill='none' stroke-linecap='round'/><circle cx='25' cy='18.8' r='1.1' fill='white'/><circle cx='27.5' cy='21.2' r='1.1' fill='white'/></svg>">

  {# No-flash theme bootstrap #}
  <script>
    (function () {
      try {
        var saved = localStorage.getItem('genecurator-theme');
        if (saved !== 'light' && saved !== 'dark') saved = 'light';
        document.documentElement.setAttribute('data-theme', saved);
        document.documentElement.classList.add('no-transition');
        window.addEventListener('load', function () {
          requestAnimationFrame(function () {
            document.documentElement.classList.remove('no-transition');
          });
        });
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'light');
      }
    })();
  </script>

  <link rel="stylesheet" href="/static/css/fonts.css">
  <link rel="stylesheet" href="/static/css/tabler-icons.min.css">
  <link rel="stylesheet" href="/static/css/styles.css">

  <script src="/static/js/app.js"></script>
  <script defer src="/static/js/alpine.min.js"></script>
  <script src="/static/js/plotly.min.js"></script>
</head>
<body class="antialiased">
  <div class="gc-shell max-w-[1280px] mx-auto my-6">

    {# ------- Top nav — solid navy, custom SVG logo, coral step pill ------- #}
    <div style="background: var(--brand);" class="px-8 py-4 flex items-center justify-between">
      <div class="flex items-center gap-3.5">

        {# Custom SVG logo — GC monogram + coral DNA crossbar #}
        <svg width="36" height="36" viewBox="0 0 40 40" class="flex-shrink-0">
          <rect x="0" y="0" width="40" height="40" rx="4" fill="#0369a1"/>
          <g transform="translate(20, 20)">
            <path d="M 6 -8 A 10 10 0 1 0 10 10 L 10 2 L 2 2"
                  stroke="#ffffff" stroke-width="2.8" fill="none"
                  stroke-linecap="round" stroke-linejoin="round"
                  transform="translate(-4, -1)"/>
          </g>
          <circle cx="20" cy="34" r="1.2" fill="#ea580c"/>
        </svg>

        <div class="text-white" style="font-family: 'IBM Plex Sans', sans-serif;">
          <span class="text-[16px]" style="font-weight: 500; letter-spacing: -0.01em;">GeneCurator</span>
          <span class="mx-2.5 font-light" style="color: rgba(255,255,255,0.45);">/</span>
          <span class="text-[14px]" style="color: rgba(255,255,255,0.75); font-weight: 400; letter-spacing: 0.01em;">Human-in-the-Loop Gene Selector</span>
        </div>
      </div>

      {# Right side: docs link + info button + theme toggle + step pill #}
      <div class="flex items-center gap-2.5">
        <a href="/docs" target="_blank" rel="noopener"
           class="text-[12px] px-2 py-1 rounded-sm transition-colors"
           style="color: rgba(255,255,255,0.75); text-decoration: none; letter-spacing: 0.02em;"
           onmouseover="this.style.color='#ffffff'"
           onmouseout="this.style.color='rgba(255,255,255,0.75)'"
           title="Open documentation in a new tab">
          Documentation
        </a>
        <a href="/docs" target="_blank" rel="noopener"
           class="gc-theme-toggle"
           title="Open documentation in a new tab"
           aria-label="Open documentation">
          <i class="ti ti-info-circle" style="font-size: 15px;"></i>
        </a>
        <div x-data="themeToggle" class="flex items-center gap-2.5">
          <button class="gc-theme-toggle" @click="toggle()"
                  :title="theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme'"
                  aria-label="Toggle color theme">
            <i class="ti" :class="theme === 'dark' ? 'ti-sun' : 'ti-moon'"></i>
          </button>
        </div>
        {% if step > 0 %}
          {% set is_done = step >= 5 %}
          <span class="gc-step-pill {% if is_done %}gc-step-pill-done{% endif %}">
            {% if is_done %}Analysis complete{% else %}Step {{ step }} of 4{% endif %}
          </span>
        {% endif %}
      </div>
    </div>

    {# ------- Progress steps — hidden on /docs and other non-workflow pages ------- #}
    {% if step > 0 %}
    <div class="px-8 py-3.5 flex gap-3 border-b" style="background: var(--bg-inset); border-color: var(--border);">
      {% for n, label in [(1,'Data upload'),(2,'Feature selection'),(3,'Expert review'),(4,'Results')] %}
        <div class="flex-1 flex items-center gap-2.5">
          {% if n < step %}
            <div class="gc-step-bubble" style="background: var(--ok-solid); color: white;"><i class="ti ti-check" style="font-size: 13px;"></i></div>
            <span class="text-[12px] whitespace-nowrap" style="color: var(--text-muted); font-weight: 400;">{{ label }}</span>
          {% elif n == step %}
            <div class="gc-step-bubble" style="background: var(--brand-500); color: white;">{{ n }}</div>
            <span class="text-[12px] whitespace-nowrap" style="color: var(--text-strong); font-weight: 500;">{{ label }}</span>
          {% else %}
            <div class="gc-step-bubble" style="background: transparent; border: 1px solid var(--border-strong); color: var(--text-faint);">{{ n }}</div>
            <span class="text-[12px] whitespace-nowrap" style="color: var(--text-faint); font-weight: 400;">{{ label }}</span>
          {% endif %}
          {% if n < 4 %}
            <div class="flex-1 h-px" {% if n < step %}style="background: var(--ok-solid);"{% else %}style="background: var(--border);"{% endif %}></div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
    {% endif %}

    {% block content %}{% endblock %}

  </div>
</body>
</html>
