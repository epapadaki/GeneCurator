{# Base layout shared by all four wizard steps. #}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GeneCurator</title>

  {# Custom SVG favicon — GC monogram with coral DNA crossbar #}
  <link rel="icon" href="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'><rect width='40' height='40' rx='4' fill='%230369a1'/><path d='M 20 8 A 12 12 0 1 0 32 20 L 22 20' stroke='white' stroke-width='2.8' fill='none' stroke-linecap='round'/><path d='M 22 20 Q 26 17.5 30.5 20' stroke='%23ea580c' stroke-width='1.6' fill='none' stroke-linecap='round'/><path d='M 22 20 Q 26 22.5 30.5 20' stroke='%23ea580c' stroke-width='1.6' fill='none' stroke-linecap='round'/><circle cx='25' cy='18.8' r='1.1' fill='white'/><circle cx='27.5' cy='21.2' r='1.1' fill='white'/></svg>">

  {# No-flash theme bootstrap #}
  <script>
    (function () {
      try {
        var saved = localStorage.getItem('genecurator-theme');
        if (saved !== 'light' && saved !== 'dark') saved = 'light';
        document.documentElement.setAttribute('data-theme', saved);
        document.documentElement.classList.add('no-transition');
        window.addEventListener('load', function () {
          requestAnimationFrame(function () {
            document.documentElement.classList.remove('no-transition');
          });
        });
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'light');
      }
    })();
  </script>

  <link rel="stylesheet" href="/static/css/fonts.css">
  <link rel="stylesheet" href="/static/css/tabler-icons.min.css">
  <link rel="stylesheet" href="/static/css/styles.css">

  <script src="/static/js/app.js"></script>
  <script defer src="/static/js/alpine.min.js"></script>
  <script src="/static/js/plotly.min.js"></script>
</head>
<body class="antialiased">
  <div class="gc-shell max-w-[1280px] mx-auto my-6">

    {# ------- Top nav — solid navy, custom SVG logo, coral step pill ------- #}
    <div style="background: var(--brand);" class="px-8 py-4 flex items-center justify-between">
      <div class="flex items-center gap-3.5">

        {# Custom SVG logo — GC monogram + coral DNA crossbar #}
        <svg width="36" height="36" viewBox="0 0 40 40" class="flex-shrink-0">
          <rect x="0" y="0" width="40" height="40" rx="4" fill="#0369a1"/>
          <g transform="translate(20, 20)">
            <path d="M 6 -8 A 10 10 0 1 0 10 10 L 10 2 L 2 2"
                  stroke="#ffffff" stroke-width="2.8" fill="none"
                  stroke-linecap="round" stroke-linejoin="round"
                  transform="translate(-4, -1)"/>
          </g>
          <circle cx="20" cy="34" r="1.2" fill="#ea580c"/>
        </svg>

        <div class="text-white" style="font-family: 'IBM Plex Sans', sans-serif;">
          <span class="text-[16px]" style="font-weight: 500; letter-spacing: -0.01em;">GeneCurator</span>
          <span class="mx-2.5 font-light" style="color: rgba(255,255,255,0.45);">/</span>
          <span class="text-[14px]" style="color: rgba(255,255,255,0.75); font-weight: 400; letter-spacing: 0.01em;">Human-in-the-Loop Gene Selector</span>
        </div>
      </div>

      {# Right side: docs link + info button + theme toggle + step pill #}
      <div class="flex items-center gap-2.5">
        <a href="/docs" target="_blank" rel="noopener"
           class="text-[12px] px-2 py-1 rounded-sm transition-colors"
           style="color: rgba(255,255,255,0.75); text-decoration: none; letter-spacing: 0.02em;"
           onmouseover="this.style.color='#ffffff'"
           onmouseout="this.style.color='rgba(255,255,255,0.75)'"
           title="Open documentation in a new tab">
          Documentation
        </a>
        <a href="/docs" target="_blank" rel="noopener"
           class="gc-theme-toggle"
           title="Open documentation in a new tab"
           aria-label="Open documentation">
          <i class="ti ti-info-circle" style="font-size: 15px;"></i>
        </a>
        <div x-data="themeToggle" class="flex items-center gap-2.5">
          <button class="gc-theme-toggle" @click="toggle()"
                  :title="theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme'"
                  aria-label="Toggle color theme">
            <i class="ti" :class="theme === 'dark' ? 'ti-sun' : 'ti-moon'"></i>
          </button>
        </div>
        {% if step > 0 %}
          {% set is_done = step >= 5 %}
          <span class="gc-step-pill {% if is_done %}gc-step-pill-done{% endif %}">
            {% if is_done %}Analysis complete{% else %}Step {{ step }} of 4{% endif %}
          </span>
        {% endif %}
      </div>
    </div>

    {# ------- Progress steps — hidden on /docs and other non-workflow pages ------- #}
    {% if step > 0 %}
    <div class="px-8 py-3.5 flex gap-3 border-b" style="background: var(--bg-inset); border-color: var(--border);">
      {% for n, label in [(1,'Data upload'),(2,'Feature selection'),(3,'Expert review'),(4,'Results')] %}
        <div class="flex-1 flex items-center gap-2.5">
          {% if n < step %}
            <div class="gc-step-bubble" style="background: var(--ok-solid); color: white;"><i class="ti ti-check" style="font-size: 13px;"></i></div>
            <span class="text-[12px] whitespace-nowrap" style="color: var(--text-muted); font-weight: 400;">{{ label }}</span>
          {% elif n == step %}
            <div class="gc-step-bubble" style="background: var(--brand-500); color: white;">{{ n }}</div>
            <span class="text-[12px] whitespace-nowrap" style="color: var(--text-strong); font-weight: 500;">{{ label }}</span>
          {% else %}
            <div class="gc-step-bubble" style="background: transparent; border: 1px solid var(--border-strong); color: var(--text-faint);">{{ n }}</div>
            <span class="text-[12px] whitespace-nowrap" style="color: var(--text-faint); font-weight: 400;">{{ label }}</span>
          {% endif %}
          {% if n < 4 %}
            <div class="flex-1 h-px" {% if n < step %}style="background: var(--ok-solid);"{% else %}style="background: var(--border);"{% endif %}></div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
    {% endif %}

    {% block content %}{% endblock %}

  </div>

  {# ==================== GLOBAL METHOD GUIDE MODAL ==================== #}
  {# Static reference modal for the six feature-selection algorithms.
     Lives at the top of <body> so its `position: fixed` refers to the
     viewport, not to any transformed ancestor. Opened by the (i) icon
     in Step 2 via the global functions openMethodGuide / closeMethodGuide
     defined below. Content is static and identical for every session. #}
  <div id="method-guide-modal" role="dialog" aria-modal="true" aria-labelledby="method-guide-title"
       style="display: none; position: fixed; inset: 0; z-index: 9999;
              background: rgba(15,23,42,0.55);
              align-items: flex-start; justify-content: center;
              overflow-y: auto; padding: 40px 16px;"
       onclick="if(event.target===this) closeMethodGuide()">
    <div style="width: 100%; max-width: 880px; background: var(--bg-card);
                border: 1px solid var(--border); border-radius: 4px;
                box-shadow: 0 25px 50px -12px rgba(0,0,0,0.4);">

      <!-- Header -->
      <div style="display: flex; justify-content: space-between; align-items: flex-start;
                  padding: 24px; border-bottom: 1px solid var(--border);">
        <div>
          <div style="font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em;
                      color: var(--text-muted); margin-bottom: 4px;">
            Reference
          </div>
          <h3 id="method-guide-title"
              style="font-size: 18px; font-weight: 500; color: var(--text-strong); margin: 0;">
            Method guide
          </h3>
          <p style="font-size: 12px; color: var(--text-muted); margin: 4px 0 0 0;">
            A plain-language description of each available method and when it is a good fit.
          </p>
        </div>
        <button onclick="closeMethodGuide()"
                aria-label="Close"
                style="background: none; border: none; font-size: 26px;
                       line-height: 1; padding: 0 8px; cursor: pointer;
                       color: var(--text-muted);">
          &times;
        </button>
      </div>

      <!-- Content: 6 method cards, rendered by JS on modal open -->
      <div id="method-guide-content" style="padding: 24px;"></div>

      <!-- Footer -->
      <div style="display: flex; justify-content: flex-end; padding: 16px 24px;
                  border-top: 1px solid var(--border); background: var(--bg-card-soft);">
        <button onclick="closeMethodGuide()" class="gc-btn-secondary" style="font-size: 12px;">
          Close
        </button>
      </div>
    </div>
  </div>

  <script>
    // ---- Global method guide modal ----
    // Static reference for the six feature-selection algorithms.
    // Called by the (i) icon on Step 2. Content is identical for every user.
    (function () {
      const GUIDE = [
        {
          label: "Traditional DEG",
          description: "Picks genes that pass a p-value and fold-change cut-off, then ranks them by how strong the p-value is. The simplest and most transparent option.",
          use_when: [
            "You want a clear, transparent selection rule",
            "The differential expression signal is already strong",
            "You want results any reviewer can reproduce by hand",
          ],
          avoid_when: [
            "The dataset has very few significant genes",
            "You suspect the ranking should consider how genes behave together",
          ],
        },
        {
          label: "Random Forest",
          description: "Builds many small decision trees and asks each which genes were most useful for splitting the data. The most-mentioned genes get the highest ranks. A robust, general-purpose choice.",
          use_when: [
            "The signal is not overwhelmingly strong",
            "You want a robust, safe default ranking",
            "The dataset has many genes (thousands or more)",
          ],
          avoid_when: [
            "You need a very transparent, rule-based selection",
            "The dataset is very small (fewer than 100 genes)",
          ],
        },
        {
          label: "Gradient Boosting",
          description: "Trains a sequence of decision trees where each new tree focuses on the genes the previous ones got wrong. Often finds subtle patterns that simpler methods miss.",
          use_when: [
            "The dataset is medium to large",
            "You expect important genes to interact with each other",
            "You want a strong ranking even when the signal is subtle",
          ],
          avoid_when: [
            "You want the fastest possible run",
            "You need the ranking to be easy to explain in one sentence",
          ],
        },
        {
          label: "LASSO",
          description: "Fits a linear model that is forced to keep only a small set of genes, discarding the rest. The kept genes are considered the most informative.",
          use_when: [
            "You want a small, focused panel",
            "The dataset has many genes with correlated behavior",
            "You are looking for a minimal set that still captures the signal",
          ],
          avoid_when: [
            "You need many candidate genes rather than a short list",
            "The dataset has very few samples relative to genes",
          ],
        },
        {
          label: "Elastic Net",
          description: "A middle ground between LASSO and a standard linear model. Keeps a compact set of genes but is more forgiving when many genes behave similarly.",
          use_when: [
            "You want a compact panel but LASSO seems too aggressive",
            "Many genes in the dataset behave in similar ways",
            "You want stable results across repeated runs",
          ],
          avoid_when: [
            "You want the shortest possible list (LASSO is stricter)",
            "You need a fully rule-based, transparent selection",
          ],
        },
        {
          label: "SVR",
          description: "Support-vector regression with a smooth kernel. Finds genes whose combined signal best fits the differential pattern. Useful for non-linear relationships.",
          use_when: [
            "You suspect non-linear relationships between genes and the signal",
            "The dataset is medium sized",
          ],
          avoid_when: [
            "The dataset is very large (SVR can be slow)",
            "You want quick, transparent output",
          ],
        },
      ];

      // Small helper: render a bullet list with a symbol.
      function renderTips(tips, symbol, color) {
        return tips.map(t =>
          `<li style="display: flex; gap: 6px; align-items: flex-start; margin-bottom: 4px;">
             <span style="color: ${color}; flex-shrink: 0; margin-top: 2px;">${symbol}</span>
             <span>${t}</span>
           </li>`
        ).join("");
      }

      // Render each algorithm card into a single HTML string.
      function renderContent() {
        return GUIDE.map(a => `
          <div style="padding: 16px; border-radius: 4px;
                      background: var(--bg-card-soft);
                      border: 1px solid var(--border);
                      margin-bottom: 12px;">
            <div style="font-size: 14px; font-weight: 500;
                        color: var(--text-strong); margin-bottom: 8px;">
              ${a.label}
            </div>
            <p style="font-size: 12.5px; line-height: 1.6;
                      color: var(--text-body); margin: 0 0 12px 0;">
              ${a.description}
            </p>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
              <div>
                <div style="font-size: 10px; text-transform: uppercase;
                            letter-spacing: 0.05em; color: var(--text-muted);
                            margin-bottom: 6px;">
                  Use when
                </div>
                <ul style="list-style: none; padding: 0; margin: 0;
                           font-size: 11.5px; color: var(--text-body);">
                  ${renderTips(a.use_when, "✓", "var(--brand-500)")}
                </ul>
              </div>
              <div>
                <div style="font-size: 10px; text-transform: uppercase;
                            letter-spacing: 0.05em; color: var(--text-muted);
                            margin-bottom: 6px;">
                  Avoid when
                </div>
                <ul style="list-style: none; padding: 0; margin: 0;
                           font-size: 11.5px; color: var(--text-body);">
                  ${renderTips(a.avoid_when, "×", "var(--text-faint)")}
                </ul>
              </div>
            </div>
          </div>
        `).join("");
      }

      // Global open/close functions used by inline onclick handlers.
      window.openMethodGuide = function () {
        const content = document.getElementById("method-guide-content");
        // Render only once per page load; subsequent opens reuse the DOM.
        if (content && content.childElementCount === 0) {
          content.innerHTML = renderContent();
        }
        const modal = document.getElementById("method-guide-modal");
        if (modal) modal.style.display = "flex";
      };

      window.closeMethodGuide = function () {
        const modal = document.getElementById("method-guide-modal");
        if (modal) modal.style.display = "none";
      };

      // Close on Escape.
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") window.closeMethodGuide();
      });
    })();
  </script>

</body>
</html>
