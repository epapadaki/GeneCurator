  color: var(--text-strong);
  margin-bottom: 10px;
  margin-top: 4px;
}
.docs-p {
  font-size: 13.5px;
  color: var(--text-body);
  margin-bottom: 12px;
}
.docs-ul {
  font-size: 13.5px;
  color: var(--text-body);
  margin-bottom: 12px;
  padding-left: 20px;
  list-style-type: disc;
}
.docs-ul li { margin-bottom: 6px; }
.docs-nav-link {
  display: block;
  padding: 6px 10px;
  font-size: 13px;
  color: var(--text-body);
  text-decoration: none;
  border-radius: 3px;
