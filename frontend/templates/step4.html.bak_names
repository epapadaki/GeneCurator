{% extends "base.html" %}
{% block content %}
<div x-data="step4" class="p-10 min-h-[480px]">

  <div class="text-center mb-7">
    <h1 class="text-[26px] font-bold text-gray-900 mb-2 tracking-tight">Analysis results</h1>
    <p class="text-sm text-gray-500">Statistics and biological context for your curated gene panel.</p>
  </div>

  {# 4 metric cards #}
  {# Stats strip — neutral, sober, no colored panels for neutral facts.
     Numbers are the content; color is reserved for meaningful signal
     (up/down direction of individual values, not the container). #}
  <div class="gc-stats-strip mb-7">
    <div class="gc-stat">
      <span class="gc-stat-label">Final panel</span>
      <span class="gc-stat-value" x-text="metrics.final"></span>
    </div>
    <div class="gc-stat">
      <span class="gc-stat-label">Up-regulated</span>
      <span class="gc-stat-value" x-text="metrics.up"></span>
      <span class="gc-stat-sub" x-text="metrics.pct_up + '%'"></span>
    </div>
    <div class="gc-stat">
      <span class="gc-stat-label">Down-regulated</span>
      <span class="gc-stat-value" x-text="metrics.down"></span>
      <span class="gc-stat-sub" x-text="metrics.pct_down + '%'"></span>
    </div>
    <div class="gc-stat">
      <span class="gc-stat-label">Significant (p &lt; 0.05)</span>
      <span class="gc-stat-value" x-text="metrics.sig"></span>
    </div>
  </div>

  {# Tabs #}
  {# Tabs — flat, coral-underline active, Tabler icons #}
  <div class="flex mb-5" style="border-bottom: 1px solid var(--border);">
    <template x-for="t in tabs" :key="t.id">
      <button class="gc-tab" :class="active === t.id ? 'gc-tab-active' : ''"
              @click="switchTab(t.id)">
        <i class="ti" :class="t.icon"></i>
        <span x-text="t.label"></span>
      </button>
    </template>
  </div>

  {# Tab bodies #}
  <div>
    <div x-show="active === 'volcano'">
      <div class="grid grid-cols-[3fr_2fr] gap-5">
        <div class="gc-card p-3"><div id="plot-volcano" style="min-height:420px;"></div></div>
        <div>
          <div class="text-sm font-semibold mb-2">Top discoveries</div>
          <div class="gc-card max-h-[420px] overflow-y-auto">
            <table class="w-full text-sm">
              <thead class="bg-slate-50 sticky top-0 border-b border-gray-200">
                <tr class="text-left text-[11px] uppercase tracking-wider text-gray-500 font-semibold">
                  <th class="px-3 py-2">Gene</th>
                  <th class="px-3 py-2 text-right">p-value</th>
                  <th class="px-3 py-2 text-right">log2FC</th>
                </tr>
              </thead>
              <tbody>
                <template x-for="r in topDiscoveries" :key="r.gene">
                  <tr class="border-b border-gray-100">
                    <td class="px-3 py-1.5 font-semibold" x-text="r.gene"></td>
                    <td class="px-3 py-1.5 text-right tabular-nums text-gray-500" x-text="r.p_value.toExponential(2)"></td>
                    <td class="px-3 py-1.5 text-right tabular-nums" :class="r.log2fc>0?'text-emerald-700':'text-rose-700'" x-text="r.log2fc.toFixed(2)"></td>
                  </tr>
                </template>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <div x-show="active === 'ppi'">
      <div class="gc-card p-3"><div id="plot-ppi" style="min-height:480px;"></div></div>
      <template x-if="ppiMeta && !ppiMeta.has_edges">
        <div class="mt-3 gc-card-soft p-3 text-xs text-gray-600">
          No catalogued interactions among selected genes — showing isolated nodes.
        </div>
      </template>
    </div>

    {# ==== NEW: Functional Enrichment tab ================================ #}
    <div x-show="active === 'enrichment'" x-cloak>
      <div x-data="enrichment" x-init="init()">

        {# Header + snapshot info #}
        <div class="mb-4 flex items-baseline justify-between">
          <div>
            <div class="text-[15px] font-semibold text-gray-900">Functional Enrichment</div>
            <div class="text-xs text-gray-500 mt-0.5">
              Over-representation analysis of the final gene panel (Fisher's exact + Benjamini-Hochberg FDR).
              <template x-if="status && status.kegg_snapshot_date">
                <span>KEGG snapshot: <span x-text="status.kegg_snapshot_date.split('T')[0]"></span>.</span>
              </template>
            </div>
          </div>
        </div>

        {# Error state #}
        <template x-if="error">
          <div class="gc-card-soft p-4 mb-4 text-sm" style="color: var(--bad-tx);">
            <i class="ti ti-alert-circle mr-1"></i>
            <span x-text="error"></span>
          </div>
        </template>

        {# Group sub-tabs (Pathways / Ontology / Diseases / Cell Types) #}
        <template x-if="status">
          <div class="flex gap-1 mb-4 border-b border-gray-200 pb-2">
            <template x-for="group in ['pathways','ontology','diseases','cell_types','drugs']" :key="group">
              <button x-show="groupHasAvailableLib(group)"
                      class="px-3 py-1.5 rounded-md text-xs font-medium capitalize"
                      :class="activeGroup === group
                              ? 'bg-indigo-50 text-indigo-700 font-semibold'
                              : 'text-gray-500 hover:text-gray-900'"
                      @click="selectGroup(group)"
                      x-text="group.replace('_',' ')"></button>
            </template>
          </div>
        </template>

        {# Library chips within the active group #}
        <template x-if="status && status.catalog[activeGroup]">
          <div class="flex flex-wrap gap-2 mb-4">
            <template x-for="pair in status.catalog[activeGroup]" :key="pair[0]">
              <button x-show="status.libraries[pair[0]]"
                      @click="selectLibrary(pair[0])"
                      class="px-3 py-1 rounded-full text-xs font-medium border"
                      :class="activeLibrary === pair[0]
                              ? 'bg-indigo-500 text-white border-indigo-500'
                              : 'bg-transparent border-gray-300 text-gray-600 hover:border-indigo-400'"
                      x-text="pair[1]"></button>
            </template>
          </div>
        </template>

        {# Results table #}
        <div class="gc-card overflow-hidden">
          <template x-if="loading">
            <div class="p-8 text-center text-sm text-gray-500">
              <i class="ti ti-loader animate-spin mr-1"></i> Computing enrichment...
            </div>
          </template>

          <template x-if="!loading && currentResults().length === 0 && !error">
            <div class="p-8 text-center text-sm text-gray-500">
              No enriched terms found for
              <span class="font-semibold" x-text="libraryLabel(activeLibrary)"></span>.
              Your gene panel may be too small or too specific.
            </div>
          </template>

          <template x-if="!loading && currentResults().length > 0">
            <div class="max-h-[540px] overflow-y-auto">
              <table class="w-full text-sm">
                <thead class="bg-slate-50 sticky top-0 border-b border-gray-200 z-10">
                  <tr class="text-left text-[11px] uppercase tracking-wider text-gray-500 font-semibold">
                    <th class="px-3 py-2">#</th>
                    <th class="px-3 py-2">Term</th>
                    <th class="px-3 py-2 text-right">p-value</th>
                    <th class="px-3 py-2 text-right">FDR (q)</th>
                    <th class="px-3 py-2 text-right">Overlap</th>
                    <th class="px-3 py-2">Genes</th>
                    <th x-show="isKeggLibrary() && status?.kegg_maps_available"
                        class="px-3 py-2 text-right">Map</th>
                  </tr>
                </thead>
                <tbody>
                  <template x-for="(row, i) in currentResults()" :key="row.term">
                    <tr class="border-b border-gray-100 hover:bg-slate-50">
                      <td class="px-3 py-2 text-gray-400 tabular-nums" x-text="i + 1"></td>
                      <td class="px-3 py-2">
                        <div class="font-medium text-gray-900" x-text="row.term"></div>
                        <div class="w-full h-1 mt-1 rounded" style="background: var(--bg-inset);">
                          <div class="h-1 rounded"
                               :style="`width:${barLenP(row, currentResults())}%; background: var(--accent);`"></div>
                        </div>
                      </td>
                      <td class="px-3 py-2 text-right tabular-nums text-gray-600"
                          x-text="fmtP(row.p_value)"></td>
                      <td class="px-3 py-2 text-right tabular-nums font-semibold"
                          :class="row.q_value < 0.05 ? 'text-emerald-700' : 'text-gray-500'"
                          x-text="fmtP(row.q_value)"></td>
                      <td class="px-3 py-2 text-right tabular-nums text-gray-600" x-text="fmtOverlap(row)"></td>
                      <td class="px-3 py-2 text-xs text-gray-600" style="max-width: 260px;">
                        <span x-text="row.overlap_genes.slice(0,6).join(', ')"></span>
                        <template x-if="row.overlap_genes.length > 6">
                          <span class="text-gray-400" x-text="` + ${row.overlap_genes.length - 6} more`"></span>
                        </template>
                      </td>
                      <td x-show="isKeggLibrary() && status?.kegg_maps_available" class="px-3 py-2 text-right">
                        <button class="px-2 py-1 rounded-md text-xs bg-indigo-50 text-indigo-700 hover:bg-indigo-100"
                                @click="openMap(row.term)"
                                title="View KEGG pathway map with your genes highlighted">
                          <i class="ti ti-map"></i> map
                        </button>
                      </td>
                    </tr>
                  </template>
                </tbody>
              </table>
            </div>
          </template>
        </div>

        {# KEGG Map modal is created directly in <body> by openMap() in
           enrichment.js — bypasses Alpine's x-teleport (which can lose scope
           in nested x-data) and any .gc-shell overflow clipping. Kept
           entirely in plain DOM so it's bulletproof. #}

      </div>{# end x-data="enrichment" #}
    </div>
    {# ==== end Enrichment tab =========================================== #}

    {# ==== LR pairs tab ================================================= #}
    <div x-show="active === 'lr'" x-cloak>
      {# Loading placeholder #}
      <div x-show="!lrData && !lrError" class="gc-card p-6 text-center text-sm text-gray-500">
        Loading LR annotation…
      </div>

      {# Error banner #}
      <div x-show="lrError" x-cloak
           class="gc-card p-4 text-sm"
           style="background: var(--bad-bg); color: var(--bad-tx); border: 1px solid var(--bad-bd);">
        <div class="flex items-start gap-2">
          <i class="ti ti-alert-circle" style="font-size: 16px; flex-shrink: 0; margin-top: 2px;"></i>
          <span x-text="lrError"></span>
        </div>
      </div>

      {# Main content — only render once data has arrived #}
      <template x-if="lrData">
        <div>
          {# Header row: intro + attribution + summary stats #}
          <div class="gc-card-soft p-4 mb-4">
            <div class="text-[15px] font-semibold text-gray-900 mb-1">Ligand-Receptor annotation</div>
            <div class="text-[12px] text-gray-600 mb-3">
              Annotation of the curated panel against known human ligand-receptor pairs. This module identifies known ligands, receptors, and complete LR pairs in the panel. It does not infer cell-cell communication, which requires single-cell resolution data.
            </div>

            {# Summary stat strip #}
            <div class="grid grid-cols-5 gap-3 pt-3" style="border-top: 1px solid var(--border);">
              <div>
                <div class="text-[10px] uppercase tracking-wider text-gray-500">Ligands</div>
                <div class="text-xl tabular-nums" x-text="lrData.n_ligands"></div>
              </div>
              <div>
                <div class="text-[10px] uppercase tracking-wider text-gray-500">Receptors</div>
                <div class="text-xl tabular-nums" x-text="lrData.n_receptors"></div>
              </div>
              <div>
                <div class="text-[10px] uppercase tracking-wider text-gray-500">Both roles</div>
                <div class="text-xl tabular-nums" x-text="lrData.n_both"></div>
              </div>
              <div>
                <div class="text-[10px] uppercase tracking-wider text-gray-500">Complete pairs</div>
                <div class="text-xl tabular-nums" x-text="lrData.n_complete_pairs"></div>
              </div>
              <div>
                <div class="text-[10px] uppercase tracking-wider text-gray-500">Partial pairs</div>
                <div class="text-xl tabular-nums"
                     x-text="(lrData.n_partial_ligand_side_total + lrData.n_partial_receptor_side_total)"></div>
              </div>
            </div>
          </div>

          {# Complete pairs — most interesting to show first #}
          <div x-show="lrData.n_complete_pairs > 0" class="mb-4">
            <div class="text-[13px] font-semibold text-gray-800 mb-2">
              Complete pairs in the panel (<span x-text="lrData.n_complete_pairs"></span>)
            </div>
            <div class="gc-card overflow-hidden">
              <table class="w-full text-sm">
                <thead class="text-[11px] uppercase tracking-wider text-gray-500"
                       style="background: var(--bg-inset);">
                  <tr>
                    <th class="text-left px-3 py-2">Ligand</th>
                    <th class="text-left px-3 py-2"></th>
                    <th class="text-left px-3 py-2">Receptor</th>
                    <th class="text-right px-3 py-2">Evidence</th>
                  </tr>
                </thead>
                <tbody>
                  <template x-for="p in lrData.complete_pairs" :key="p.ligand + '_' + p.receptor">
                    <tr style="border-top: 1px solid var(--border);">
                      <td class="px-3 py-2 font-semibold" style="font-family: monospace;" x-text="p.ligand"></td>
                      <td class="px-3 py-2 text-gray-400">→</td>
                      <td class="px-3 py-2 font-semibold" style="font-family: monospace;" x-text="p.receptor"></td>
                      <td class="px-3 py-2 text-right">
                        <a x-show="p.evidence" :href="firstPubmedUrl(p.evidence)" target="_blank"
                           class="text-xs text-blue-600 hover:underline" x-text="'PMID ' + (p.evidence || '').split(/[,;\s]+/)[0]"></a>
                      </td>
                    </tr>
                  </template>
                </tbody>
              </table>
            </div>
          </div>

          {# Message when no complete pairs #}
          <div x-show="lrData.n_complete_pairs === 0" class="mb-4">
            <div class="gc-card p-3 text-[12px] text-gray-600" style="background: var(--bg-inset);">
              No complete LR pairs entirely inside the panel. This is common in curated cancer biomarker panels where receptors are typically included but the corresponding secreted ligands originate from other cell types.
            </div>
          </div>

          {# Panel classification #}
          <div x-show="lrData.classifications.length > 0" class="mb-4">
            <div class="text-[13px] font-semibold text-gray-800 mb-2">
              Panel members with a known LR role (<span x-text="lrData.classifications.length"></span>)
            </div>
            <div class="gc-card overflow-hidden">
              <table class="w-full text-sm">
                <thead class="text-[11px] uppercase tracking-wider text-gray-500"
                       style="background: var(--bg-inset);">
                  <tr>
                    <th class="text-left px-3 py-2">Symbol</th>
                    <th class="text-left px-3 py-2">Role</th>
                  </tr>
                </thead>
                <tbody>
                  <template x-for="c in lrData.classifications" :key="c.symbol">
                    <tr style="border-top: 1px solid var(--border);">
                      <td class="px-3 py-2 font-semibold" style="font-family: monospace;" x-text="c.symbol"></td>
                      <td class="px-3 py-2">
                        <span class="text-[10px] px-2 py-0.5 rounded uppercase tracking-wider"
                              :style="c.role === 'ligand' ? 'background: #dbeafe; color: #1e40af;' :
                                      c.role === 'receptor' ? 'background: #fef3c7; color: #92400e;' :
                                      'background: #e0e7ff; color: #4338ca;'"
                              x-text="c.role"></span>
                      </td>
                    </tr>
                  </template>
                </tbody>
              </table>
            </div>
          </div>

          {# Partial pairs — receptor in panel, ligand missing #}
          <div x-show="lrData.partial_receptor_side.length > 0" class="mb-4">
            <div class="text-[13px] font-semibold text-gray-800 mb-2">
              Receptors in panel with cognate ligands in dataset
              (<span x-text="lrData.n_partial_receptor_side_total"></span><span x-show="lrData.n_partial_receptor_side_total > 30"> — showing first 30</span>)
            </div>
            <div class="text-[11px] text-gray-500 mb-2">
              These ligands are known partners of receptors in your panel but are not currently included. Consider whether they are biologically relevant to your analysis.
            </div>
            <div class="gc-card overflow-hidden">
              <table class="w-full text-sm">
                <thead class="text-[11px] uppercase tracking-wider text-gray-500"
                       style="background: var(--bg-inset);">
                  <tr>
                    <th class="text-left px-3 py-2">Ligand (missing)</th>
                    <th class="text-left px-3 py-2"></th>
                    <th class="text-left px-3 py-2">Receptor (in panel)</th>
                    <th class="text-right px-3 py-2">Evidence</th>
                    <th class="text-right px-3 py-2 pr-3"></th>
                  </tr>
                </thead>
                <tbody>
                  <template x-for="p in lrData.partial_receptor_side" :key="p.ligand + '_' + p.receptor">
                    <tr style="border-top: 1px solid var(--border);">
                      <td class="px-3 py-2 font-semibold text-gray-500" style="font-family: monospace;" x-text="p.ligand"></td>
                      <td class="px-3 py-2 text-gray-400">→</td>
                      <td class="px-3 py-2 font-semibold" style="font-family: monospace;" x-text="p.receptor"></td>
                      <td class="px-3 py-2 text-right">
                        <a x-show="p.evidence" :href="firstPubmedUrl(p.evidence)" target="_blank"
                           class="text-xs text-blue-600 hover:underline" x-text="'PMID ' + (p.evidence || '').split(/[,;\s]+/)[0]"></a>
                      </td>
                      <td class="px-3 py-2 text-right">
                        <button @click="addGeneFromLR(p.ligand)"
                                class="text-[11px] px-2 py-0.5 rounded"
                                style="background: var(--brand-500); color: white;">
                          Add ligand
                        </button>
                      </td>
                    </tr>
                  </template>
                </tbody>
              </table>
            </div>
          </div>

          {# Partial pairs — ligand in panel, receptor missing #}
          <div x-show="lrData.partial_ligand_side.length > 0" class="mb-4">
            <div class="text-[13px] font-semibold text-gray-800 mb-2">
              Ligands in panel with cognate receptors in dataset
              (<span x-text="lrData.n_partial_ligand_side_total"></span><span x-show="lrData.n_partial_ligand_side_total > 30"> — showing first 30</span>)
            </div>
            <div class="text-[11px] text-gray-500 mb-2">
              These receptors are known partners of ligands in your panel but are not currently included.
            </div>
            <div class="gc-card overflow-hidden">
              <table class="w-full text-sm">
                <thead class="text-[11px] uppercase tracking-wider text-gray-500"
                       style="background: var(--bg-inset);">
                  <tr>
                    <th class="text-left px-3 py-2">Ligand (in panel)</th>
                    <th class="text-left px-3 py-2"></th>
                    <th class="text-left px-3 py-2">Receptor (missing)</th>
                    <th class="text-right px-3 py-2">Evidence</th>
                    <th class="text-right px-3 py-2 pr-3"></th>
                  </tr>
                </thead>
                <tbody>
                  <template x-for="p in lrData.partial_ligand_side" :key="p.ligand + '_' + p.receptor">
                    <tr style="border-top: 1px solid var(--border);">
                      <td class="px-3 py-2 font-semibold" style="font-family: monospace;" x-text="p.ligand"></td>
                      <td class="px-3 py-2 text-gray-400">→</td>
                      <td class="px-3 py-2 font-semibold text-gray-500" style="font-family: monospace;" x-text="p.receptor"></td>
                      <td class="px-3 py-2 text-right">
                        <a x-show="p.evidence" :href="firstPubmedUrl(p.evidence)" target="_blank"
                           class="text-xs text-blue-600 hover:underline" x-text="'PMID ' + (p.evidence || '').split(/[,;\s]+/)[0]"></a>
                      </td>
                      <td class="px-3 py-2 text-right">
                        <button @click="addGeneFromLR(p.receptor)"
                                class="text-[11px] px-2 py-0.5 rounded"
                                style="background: var(--brand-500); color: white;">
                          Add receptor
                        </button>
                      </td>
                    </tr>
                  </template>
                </tbody>
              </table>
            </div>
          </div>

          {# Attribution footer #}
          <div class="text-[10px] text-gray-500 pt-3" style="border-top: 1px solid var(--border);">
            Data source: <span x-text="lrData.database_info.source"></span>
            (<span x-text="lrData.database_info.n_pairs_total"></span> total pairs).
            Accessed via the LewisLab UCSD compendium.
          </div>
        </div>
      </template>
    </div>
    {# ==== end LR pairs tab ============================================= #}

    <div x-show="active === 'log2fc'">
      <div class="gc-card p-3"><div id="plot-log2fc" style="min-height:420px;"></div></div>
    </div>
  </div>

  {# Summary + Export #}
  <div class="grid grid-cols-2 gap-5 mt-8">
    <div class="gc-card-soft p-5">
      <div class="text-[15px] font-semibold text-gray-900 mb-4">Analysis Summary</div>
      <div class="space-y-3 text-[13px]">
        <div class="flex justify-between pb-3 border-b border-gray-200">
          <span class="text-gray-500">Initial genes</span>
          <span class="font-semibold text-gray-900" x-text="state.rows"></span>
        </div>
        <div class="flex justify-between pb-3 border-b border-gray-200">
          <span class="text-gray-500">Algorithm picks</span>
          <span class="font-semibold text-gray-900" x-text="state.n_algo_picks"></span>
        </div>
        <div class="flex justify-between pb-3 border-b border-gray-200">
          <span class="text-gray-500">Manually added</span>
          <span class="font-semibold text-emerald-600">+<span x-text="state.added?.length || 0"></span></span>
        </div>
        <div class="flex justify-between pb-3 border-b border-gray-200">
          <span class="text-gray-500">Manually rejected</span>
          <span class="font-semibold text-rose-600">−<span x-text="state.rejected?.length || 0"></span></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-500">Algorithm</span>
          <span class="font-semibold text-indigo-600" x-text="state.strategy"></span>
        </div>
      </div>
    </div>
    <div class="gc-card p-5">
      <div class="text-[15px] font-semibold text-gray-900 mb-4">Export Results</div>
      <a href="/api/export.xlsx" class="block w-full text-center gc-btn-primary mb-2">
        <i class="ti ti-download mr-1.5"></i>Download Excel report
      </a>
      <a href="/api/export.csv" class="block w-full text-center gc-btn-secondary">
        <i class="ti ti-download mr-1.5"></i>Download gene panel (CSV)
      </a>
    </div>
  </div>

  <div class="gc-actionbar">
    <button class="gc-btn-secondary" @click="window.location='/step/3'">← Back to Review</button>
    <button class="gc-btn-secondary" @click="restart()"><i class="ti ti-refresh mr-1"></i>New Analysis</button>
  </div>
</div>{# end x-data="step4" #}
{% endblock %}
