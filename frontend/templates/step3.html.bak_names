{% extends "base.html" %}
{% block content %}
<div x-data="step3" class="p-10 min-h-[480px]">

  <div class="text-center mb-7">
    <h1 class="text-[26px] font-bold text-gray-900 mb-2 tracking-tight">Expert review</h1>
    <p class="text-sm text-gray-500">Curate the algorithm's gene panel — review evidence, then add or remove genes.</p>
  </div>

  {# Counts strip — neutral display #}
  <div class="gc-stats-strip mb-7">
    <div class="gc-stat">
      <span class="gc-stat-label">Algorithm picks</span>
      <span class="gc-stat-value" x-text="state.n_algo_picks || 0"></span>
    </div>
    <div class="gc-stat">
      <span class="gc-stat-label">Final panel</span>
      <span class="gc-stat-value" x-text="state.n_final || 0"></span>
    </div>
    <div class="gc-stat">
      <span class="gc-stat-label">Added</span>
      <span class="gc-stat-value">+<span x-text="state.added?.length || 0"></span></span>
    </div>
    <div class="gc-stat">
      <span class="gc-stat-label">Removed</span>
      <span class="gc-stat-value">−<span x-text="state.rejected?.length || 0"></span></span>
    </div>
  </div>

  <div class="grid grid-cols-[2.2fr_1fr] gap-6">

    {# LEFT: interactive table #}
    <div>
      <div class="gc-section-label">Algorithm Ranking · <span x-text="state.strategy"></span></div>
      <div class="gc-card-soft p-3 text-xs text-gray-600 leading-relaxed mb-3">
        <b>Untick a row’s checkbox</b> to remove that gene from your final panel. Re-tick to restore it. To add genes the algorithm didn’t pick, use the <b>Gene Inspector</b> on the right.
      </div>

      <div class="gc-card overflow-hidden">
        <div class="max-h-[420px] overflow-y-auto">
          <table class="w-full text-sm">
            <thead class="bg-slate-50 border-b border-gray-200 sticky top-0">
              <tr class="text-left text-[11px] uppercase tracking-wider text-gray-500 font-semibold">
                <th class="px-3 py-2 w-12">In&nbsp;Panel</th>
                <th class="px-3 py-2 w-12">Rank</th>
                <th class="px-3 py-2">Gene</th>
                <th class="px-3 py-2 text-right">Score</th>
                <th class="px-3 py-2 text-right">log2FC</th>
                <th class="px-3 py-2 text-right">p-value</th>
              </tr>
            </thead>
            <tbody>
              <template x-for="row in state.table_rows" :key="row.gene">
                <tr class="border-b border-gray-100 hover:bg-slate-50 cursor-pointer"
                    :class="!row.in_panel && 'opacity-50'"
                    @click="inspect(row.gene)">
                  <td class="px-3 py-2">
                    <input type="checkbox" :checked="row.in_panel"
                           @click.stop="toggleRow(row.gene, $event.target.checked)"
                           class="w-4 h-4 accent-indigo-500 rounded">
                  </td>
                  <td class="px-3 py-2 text-gray-500 tabular-nums" x-text="row.rank"></td>
                  <td class="px-3 py-2 font-semibold text-gray-900" x-text="row.gene"></td>
                  <td class="px-3 py-2 text-right tabular-nums" x-text="row.score.toFixed(3)"></td>
                  <td class="px-3 py-2 text-right tabular-nums" :class="row.log2fc > 0 ? 'text-emerald-700' : 'text-rose-700'" x-text="row.log2fc.toFixed(2)"></td>
                  <td class="px-3 py-2 text-right tabular-nums text-gray-500" x-text="row.p_value.toExponential(2)"></td>
                </tr>
              </template>
              <tr x-show="!state.table_rows || state.table_rows.length === 0">
                <td colspan="6" class="px-3 py-8 text-center text-sm text-gray-400">No algorithm picks yet.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      {# Quick actions #}
      <div class="grid grid-cols-2 gap-3 mt-3">
        <button class="gc-btn-secondary" @click="reset()"><i class="ti ti-refresh mr-1"></i>Reset to algorithm picks</button>
        <button class="gc-btn-secondary" @click="clearAll()" :disabled="(state.n_final||0) === 0"><i class="ti ti-x mr-1"></i>Clear panel</button>
      </div>
    </div>

    {# RIGHT: Gene Inspector + Agent suggestions #}
    <div>

      {# ==================== AGENT SUGGESTIONS ==================== #}
      {# LLM-assisted curation. The user optionally declares a biological
         context (e.g., "TCGA-BRCA tumor vs normal") which the agent uses
         as ground truth. Without a context, the agent flags its inference
         as uncertain. #}
      <div class="gc-card-soft p-3 mb-4" style="border: 1px solid var(--border);">
        <div class="flex items-center justify-between mb-2">
          <div class="text-[11px]" style="letter-spacing: 0.06em; color: var(--text-muted); font-weight: 500; text-transform: uppercase;">
            AI curation assistant
          </div>
          <button @click="requestAgentSuggestions()"
                  :disabled="agentBusy"
                  class="gc-btn-secondary text-xs inline-flex items-center gap-1.5"
                  style="padding: 4px 10px;">
            <i class="ti ti-sparkles" style="font-size: 12px;"></i>
            <span x-text="agentBusy ? 'Thinking…' : (agentHasResults ? 'Refresh' : 'Suggest curation')"></span>
          </button>
        </div>

        {# Context input — optional but strongly recommended #}
        <div class="mb-2">
          <label class="text-[10px]"
                 style="letter-spacing: 0.03em; color: var(--text-muted); font-weight: 500;">
            Dataset context <span style="color: var(--text-faint);">(optional but recommended)</span>
          </label>
          <input type="text" x-model="agentContext_input"
                 placeholder="e.g. TCGA-BRCA tumor vs normal (breast cancer)"
                 class="w-full mt-1 border border-gray-200 rounded px-2 py-1.5 text-[11px]"
                 :disabled="agentBusy"
                 style="font-family: monospace; background: var(--bg-card);">
          <div class="text-[9px] mt-0.5" style="color: var(--text-faint); line-height: 1.4;">
            When provided, the agent treats this as ground truth. When empty, it will attempt to infer the context and flag its uncertainty.
          </div>
        </div>

        {# Error banner #}
        <div x-show="agentError" x-cloak
             class="mt-2 p-2 text-[11px] rounded"
             style="background: var(--bad-bg); color: var(--bad-tx); border: 1px solid var(--bad-bd);">
          <div class="flex items-start gap-2">
            <i class="ti ti-alert-circle" style="font-size: 14px; flex-shrink: 0; margin-top: 1px;"></i>
            <span x-text="agentError"></span>
          </div>
        </div>

        {# Context summary — with warning styling when context wasn't provided #}
        <div x-show="agentContext && !agentError" x-cloak
             class="mt-2 p-2 text-[11px] rounded"
             :style="agentContextProvided
                     ? 'background: var(--bg-inset); color: var(--text-body); font-style: italic;'
                     : 'background: var(--warn-bg); color: var(--warn-tx); font-style: italic; border: 1px solid var(--warn-bd);'">
          <div class="flex items-start gap-2">
            <i x-show="!agentContextProvided" class="ti ti-alert-triangle"
               style="font-size: 13px; flex-shrink: 0; margin-top: 1px;"></i>
            <span x-text="agentContext"></span>
          </div>
        </div>

        {# Suggestions list — removals #}
        <div x-show="agentRemovals.length > 0" x-cloak class="mt-3">
          <div class="text-[10px] mb-1.5"
               style="letter-spacing: 0.04em; color: var(--text-muted); font-weight: 500; text-transform: uppercase;">
            Suggested removals
          </div>
          <div class="space-y-1.5">
            <template x-for="s in agentRemovals" :key="s.symbol">
              <div class="flex items-start gap-2 p-2 rounded text-[11px]"
                   style="background: var(--bg-card); border: 1px solid var(--border);">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-1.5">
                    <span class="font-semibold" x-text="s.symbol" style="font-family: monospace;"></span>
                    <span class="text-[9px] px-1.5 py-0.5 rounded"
                          style="background: var(--bg-inset); color: var(--text-muted); letter-spacing: 0.02em;"
                          x-text="s.category.replace(/_/g, ' ')"></span>
                  </div>
                  <div class="text-[10px] mt-0.5" style="color: var(--text-muted); line-height: 1.4;"
                       x-text="s.reason"></div>
                </div>
                <div class="flex gap-1 flex-shrink-0">
                  <button @click="acceptRemoval(s.symbol)"
                          class="text-[10px] px-2 py-0.5 rounded"
                          style="background: var(--brand-500); color: white;">
                    Apply
                  </button>
                  <button @click="dismissSuggestion(s.symbol, 'remove')"
                          class="text-[10px] px-2 py-0.5 rounded"
                          style="background: var(--bg-inset); color: var(--text-muted); border: 1px solid var(--border);">
                    Skip
                  </button>
                </div>
              </div>
            </template>
          </div>
        </div>

        {# Suggestions list — additions #}
        <div x-show="agentAdditions.length > 0" x-cloak class="mt-3">
          <div class="text-[10px] mb-1.5"
               style="letter-spacing: 0.04em; color: var(--text-muted); font-weight: 500; text-transform: uppercase;">
            Suggested additions
          </div>
          <div class="space-y-1.5">
            <template x-for="s in agentAdditions" :key="s.symbol">
              <div class="flex items-start gap-2 p-2 rounded text-[11px]"
                   style="background: var(--bg-card); border: 1px solid var(--border);">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-1.5">
                    <span class="font-semibold" x-text="s.symbol" style="font-family: monospace;"></span>
                    <span class="text-[9px] px-1.5 py-0.5 rounded"
                          style="background: var(--bg-inset); color: var(--text-muted); letter-spacing: 0.02em;"
                          x-text="s.category.replace(/_/g, ' ')"></span>
                  </div>
                  <div class="text-[10px] mt-0.5" style="color: var(--text-muted); line-height: 1.4;"
                       x-text="s.reason"></div>
                </div>
                <div class="flex gap-1 flex-shrink-0">
                  <button @click="acceptAddition(s.symbol)"
                          class="text-[10px] px-2 py-0.5 rounded"
                          style="background: var(--brand-500); color: white;">
                    Apply
                  </button>
                  <button @click="dismissSuggestion(s.symbol, 'add')"
                          class="text-[10px] px-2 py-0.5 rounded"
                          style="background: var(--bg-inset); color: var(--text-muted); border: 1px solid var(--border);">
                    Skip
                  </button>
                </div>
              </div>
            </template>
          </div>
        </div>

        {# Disclaimer footnote #}
        <div x-show="agentHasResults && !agentError" x-cloak
             class="mt-2.5 pt-2 text-[9px]"
             style="border-top: 1px solid var(--border); color: var(--text-faint); line-height: 1.4;">
          Suggestions are generated by an LLM (Gemini) based on the dataset context. Verify against literature before finalizing.
        </div>
      </div>

      {# ==================== GENE INSPECTOR ==================== #}
      <div class="gc-section-label">Gene Inspector</div>

      {# Search filter — essential when the dataset has thousands of genes.
         Type a symbol to jump directly to it in the dropdown. #}
      <input type="text" x-model="inspectorFilter"
             @input="onFilterChange()"
             placeholder="Search gene symbol (e.g. ESR1)"
             class="w-full border border-gray-200 rounded-md px-3 py-2 text-xs mb-2"
             style="font-family: monospace;">

      <select x-model="inspectedSymbol" @change="loadGene(inspectedSymbol)"
              class="w-full border border-gray-200 rounded-md px-3 py-2 text-sm mb-3">
        <template x-for="sym in filteredInspectorOptions" :key="sym">
          <option :value="sym" x-text="sym"></option>
        </template>
      </select>

      <template x-if="gene">
        <div>
          <div class="gc-card p-4">
            <div class="flex items-center justify-between mb-2.5">
              <div class="text-lg font-bold text-gray-900" x-text="gene.symbol"></div>
              <div class="flex gap-1 flex-wrap">
                <span class="gc-chip" :class="gene.in_panel ? 'gc-chip-success' : 'gc-chip-danger'"
                      x-text="gene.in_panel ? 'In panel' : 'Not in panel'"></span>
                <span class="gc-chip" :class="gene.is_algo_pick ? 'gc-chip-indigo' : 'gc-chip-gray'"
                      x-text="gene.is_algo_pick ? 'Algo pick' : 'Not picked'"></span>
              </div>
            </div>
            <div class="grid grid-cols-3 gap-2 pt-3 border-t border-gray-100">
              <div>
                <div class="text-[10px] uppercase tracking-wider font-semibold text-gray-400">log2FC</div>
                <div class="text-[15px] font-semibold tabular-nums"
                     :class="gene.log2fc > 0 ? 'text-emerald-700' : 'text-rose-700'"
                     x-text="gene.log2fc.toFixed(2)"></div>
                <div class="text-[10px] font-semibold"
                     :class="gene.log2fc > 0 ? 'text-emerald-700' : 'text-rose-700'"
                     x-text="gene.log2fc > 0 ? '↑ Up' : '↓ Down'"></div>
              </div>
              <div>
                <div class="text-[10px] uppercase tracking-wider font-semibold text-gray-400">p-value</div>
                <div class="text-[15px] font-semibold text-gray-900 tabular-nums" x-text="gene.p_value.toExponential(2)"></div>
              </div>
              <div>
                <div class="text-[10px] uppercase tracking-wider font-semibold text-gray-400">Score</div>
                <div class="text-[15px] font-semibold text-gray-900 tabular-nums" x-text="gene.score.toFixed(3)"></div>
              </div>
            </div>
          </div>

          <template x-if="gene.uniprot">
            <div class="space-y-2 mt-3">
              <div class="gc-card p-4">
                <div class="text-[10px] uppercase tracking-wider font-semibold text-gray-400 mb-1">Protein</div>
                <div class="text-[13px] text-gray-900 leading-snug" x-text="gene.uniprot.protein_name.slice(0,200)"></div>
                <div class="mt-2 text-[11px] text-gray-500">Length: <b class="text-gray-900" x-text="gene.uniprot.length"></b> aa</div>
              </div>
              <div class="gc-card p-4 border-l-4 border-emerald-500">
                <div class="text-[10px] uppercase tracking-wider font-semibold text-emerald-600 mb-1">🧪 Function</div>
                <div class="text-xs text-gray-900 leading-relaxed" x-text="gene.uniprot.function.slice(0,600)"></div>
              </div>
              <div class="gc-card p-4 border-l-4 border-rose-600">
                <div class="text-[10px] uppercase tracking-wider font-semibold text-rose-600 mb-1">⚕️ Disease involvement</div>
                <div class="text-xs text-gray-900 leading-relaxed" x-text="gene.uniprot.disease.slice(0,600)"></div>
              </div>
            </div>
          </template>

          <template x-if="!gene.uniprot && gene.uniprot_loaded">
            <div class="gc-card-soft p-4 mt-3 text-xs text-gray-500">
              No UniProt record for <b x-text="gene.symbol"></b>. The gene may be a synonym or non-human.
            </div>
          </template>

          <template x-if="!gene.uniprot_loaded">
            <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 mt-3 flex gap-3">
              <div class="w-9 h-9 bg-amber-100 text-amber-600 rounded-lg flex items-center justify-center flex-shrink-0">
                <i class="ti ti-database-off"></i>
              </div>
              <div>
                <div class="text-xs font-semibold text-amber-900">UniProt database not loaded</div>
                <div class="text-xs text-amber-800 mt-0.5">Place <code>uniprotkb_proteome_UP000005640_2026_03_30.tsv</code> in the project root to enable biological evidence lookups.</div>
              </div>
            </div>
          </template>

          <button x-show="gene.in_panel" @click="removeGene(gene.symbol)"
                  class="w-full mt-3 gc-btn-secondary border-rose-200 text-rose-600 hover:bg-rose-50">
            − Remove <span x-text="gene.symbol"></span> from panel
          </button>
          <button x-show="!gene.in_panel" @click="addGene(gene.symbol)"
                  class="w-full mt-3 gc-btn-primary">
            + Add <span x-text="gene.symbol"></span> to panel
          </button>
        </div>
      </template>
    </div>
  </div>

  <div class="gc-actionbar">
    <button class="gc-btn-secondary" @click="window.location='/step/2'">← Back</button>
    <button class="gc-btn-primary" :disabled="(state.n_final||0)===0" @click="window.location='/step/4'">
      View Results <i class="ti ti-arrow-right ml-1.5"></i>
    </button>
  </div>
</div>{# end x-data="step3" #}
{% endblock %}
