"""
Pipeline orchestration. Transplanted from the Streamlit app's run_pipeline().

Operates on a Session object (see state.py) rather than st.session_state, but
the math is identical.
"""

from typing import Dict, List, Set

import numpy as np
import pandas as pd

from .algorithms import run_engine


def run_pipeline(session) -> None:
    """Compute selected genes for the session's current data + strategy.
    Mutates session in place; identical to the Streamlit version's logic."""
    df = session.df_raw.copy()
    g, p, fc = session.g_col, session.p_col, session.fc_col
    df[p] = pd.to_numeric(df[p], errors="coerce")
    df[fc] = pd.to_numeric(df[fc], errors="coerce")
    df = df.dropna(subset=[p, fc, g]).reset_index(drop=True)
    df[g] = df[g].astype(str)
    session.df_clean = df

    if session.strategy == "Traditional DEG (Volcano)":
        p_thr = session.p_thr
        fc_thr = session.fc_thr
        df["DEG_Status"] = "NS"
        df.loc[(df[p] < p_thr) & (df[fc] > fc_thr), "DEG_Status"] = "UP"
        df.loc[(df[p] < p_thr) & (df[fc] < -fc_thr), "DEG_Status"] = "DOWN"
        sel = df[df["DEG_Status"] != "NS"][g].astype(str).tolist()
        scores = {
            str(row[g]): -float(np.log10(max(row[p], 1e-300)))
            for _, row in df.iterrows()
        }
    else:
        preds, impact = run_engine(df[[p, fc]].values, session.strategy)
        df["Rank_Score"] = preds
        sel = (
            df.sort_values("Rank_Score", ascending=False)
              .head(session.top_n)[g]
              .astype(str)
              .tolist()
        )
        scores = {str(k): float(v) for k, v in zip(df[g].astype(str), df["Rank_Score"])}
        session.global_impact = list(impact)

    session.selected_by_algo = sel
    session.rank_scores = scores
    session.rejected_genes = set()
    session.added_genes = set()
    session.ran_pipeline = True


def final_selection(session) -> List[str]:
    base = {str(x) for x in (session.selected_by_algo or [])}
    rejected = {str(x) for x in session.rejected_genes}
    added = {str(x) for x in session.added_genes}
    return sorted((base - rejected) | added)
